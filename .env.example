# Copy to .env for local development. Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://backend:backend@localhost:5432/backend
REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:3000
TIME_ZONE=UTC
# Attendance: none | toggle | device (see apps/attendance/rules.py); run
# `manage.py rebuild_attendance` after changing either setting.
ATTENDANCE_DIRECTION_RULE=none
ATTENDANCE_DAY_START_HOUR=0
