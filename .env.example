# Copy to .env for local development. Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://backend:backend@localhost:5432/backend
REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:3000
TIME_ZONE=UTC
# Language when the client sends no Accept-Language (en, ko-kp), and for reader screens.
LANGUAGE_CODE=en
DEVICE_LANGUAGE=en
# Attendance: none | toggle | device (see apps/attendance/rules.py); run
# `manage.py rebuild_attendance` after changing either setting.
# The doors report in/out with each scan:
ATTENDANCE_DIRECTION_RULE=device
ATTENDANCE_DAY_START_HOUR=0
# Sellers & goods
CURRENCY=USD
MEDIA_ROOT=/var/lib/backend/media
# Finance: largest single deposit
FINANCE_MAX_DEPOSIT=1000.00
# Purchase PIN lockout
PURCHASE_PIN_MAX_ATTEMPTS=5
PURCHASE_PIN_LOCKOUT_MINUTES=15
