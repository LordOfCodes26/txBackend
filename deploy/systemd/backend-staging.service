[Unit]
Description=Backend API staging (gunicorn on 127.0.0.1:8089, behind nginx :8088 HTTP / :8443 HTTPS)
After=network.target postgresql.service redis-server.service
Requires=postgresql.service redis-server.service

[Service]
WorkingDirectory=/root/management/backend
EnvironmentFile=/root/management/backend/.env.staging
ExecStart=/root/management/backend/.venv/bin/gunicorn config.wsgi:application \
    --bind 127.0.0.1:8089 \
    --workers 3 \
    --timeout 30 \
    --access-logfile -
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
