[Unit]
Description=Frontend staging (Next.js standalone on 127.0.0.1:3100, API at 127.0.0.1:8089)
After=network.target backend-staging.service

[Service]
WorkingDirectory=/root/management/frontend/.next/standalone
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3100
Environment=API_URL=http://127.0.0.1:8089
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
