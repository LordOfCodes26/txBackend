# Backup settings (/etc/backend/backup.conf), read by scripts/backup/*.sh.
# Where backups live on this server.
BACKUP_DIR=/var/backups/backend
# Database to back up.
DB_NAME=backend
# Uploaded files (goods images) to back up.
MEDIA_ROOT=/var/lib/backend/media
# Grist (install-grist.sh), archived nightly when it is there.
GRIST_DIR=/opt/grist
# Keep nightly dumps this many days, and this many daily base backups (with the WAL after
# the oldest one: point-in-time recovery reaches back that many days).
KEEP_DAILY_DAYS=14
KEEP_BASE_BACKUPS=7
# When the backup disk is this full (%), the oldest base backups with their WAL, then the
# oldest dumps, are deleted (the newest base backup and 3 dumps are always kept): losing old
# history is better than the database stopping on a full disk.
DISK_PRUNE_PERCENT=85
# IMPORTANT: a second disk or another machine. Backups on the same disk die with it.
# Either a mounted directory (USB disk, NAS share) ... The copy is refused (and
# /health/backup/ reports an error) while this folder is on this server's own disk, i.e.
# the backup disk isn't mounted: nothing is copied onto the server's disk by mistake.
OFFSITE_DIR=
# ... or an rsync target over SSH, e.g. backup@10.0.0.50:/srv/backups/backend
OFFSITE_RSYNC=
# Nightly backup time (HH:MM). Change it on the Backups page (Admin): it also updates the timer.
BACKUP_TIME=02:30
# The systemd units the Backups page manages (staging uses other names).
BACKUP_UNIT=backend-backup
BASE_BACKUP_UNIT=backend-basebackup
# Restoring from the Backups page runs as this systemd job (staging uses another name).
RESTORE_UNIT=backend-restore
# Largest backup file the Backups page accepts as an upload (bytes; 2 GB).
UPLOAD_MAX_BYTES=2147483648
# Status file read by GET /health/backup/ (must be readable by the web service).
STATUS_FILE=/var/lib/backend/backup-status.json
