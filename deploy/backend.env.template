# Production environment for the backend. Read by systemd (EnvironmentFile) and by
# scripts/install_offline.sh. Plain KEY=value lines only: no quotes, no spaces.
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=__SECRET_KEY__
DJANGO_ALLOWED_HOSTS=__ALLOWED_HOSTS__
DATABASE_URL=postgres://backend:__DB_PASSWORD__@localhost:5432/backend
REDIS_URL=redis://localhost:6379/0
MEDIA_ROOT=/var/lib/backend/media
CORS_ALLOWED_ORIGINS=
TIME_ZONE=UTC
TRUST_X_FORWARDED_FOR=true
LOG_LEVEL=INFO
