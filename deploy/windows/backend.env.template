# Settings of the backend on Windows. Read by every backend service (DJANGO_ENV_FILE) and
# by the scripts in deploy/windows. Plain KEY=value lines only: no quotes, no spaces.
# Paths use forward slashes (C:/Management/...), which Python accepts on Windows.
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=__SECRET_KEY__
DJANGO_ALLOWED_HOSTS=__ALLOWED_HOSTS__
DATABASE_URL=postgres://backend:__DB_PASSWORD__@localhost:__PG_PORT__/backend
# 127.0.0.1, not localhost: Windows tries IPv6 (::1) first, where Garnet doesn't listen,
# and the failed attempt takes as long as the connect timeout.
REDIS_URL=redis://127.0.0.1:__GARNET_PORT__/0
MEDIA_ROOT=__ROOT__/data/media
CORS_ALLOWED_ORIGINS=
TIME_ZONE=UTC
# Language when the client sends no Accept-Language (en, ko-kp), and for reader screens.
LANGUAGE_CODE=en
DEVICE_LANGUAGE=en
# The doors report in/out with each scan; use that for attendance.
ATTENDANCE_DIRECTION_RULE=device
# Raw TCP listener for the door devices.
RFID_TCP_PORT=9100
TRUST_X_FORWARDED_FOR=true
LOG_LEVEL=INFO
# Backups: nightly verified dumps (deploy/windows/backup.ps1), no point-in-time recovery.
BACKUP_STATUS_FILE=__ROOT__/data/backup-status.json
BACKUP_REQUIRE_PITR=false
