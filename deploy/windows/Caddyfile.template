# Caddy (the web server) on Windows, written by install-all.ps1 from
# deploy/windows/Caddyfile.template. Re-running the installer rewrites it.
#
# One address for everything, like nginx on Linux: the backend's own paths go to the
# Django services, everything else to the frontend (Next.js).
{
	http_port __HTTP_PORT__
	https_port __HTTPS_PORT__
	# The installer adds the certificate to Windows itself; the service can't.
	skip_install_trust
	# Only the frontend server (on this machine) may pass on a browser's address
	# (X-Forwarded-For), on the local-only address below.
	servers 127.0.0.1:__INTERNAL_PORT__ {
		trusted_proxies static 127.0.0.1/32
	}
}

__SITES__ {
	__TLS__
	encode gzip

	# Realtime (WebSockets).
	handle /ws/* {
		reverse_proxy 127.0.0.1:__WS_PORT__
	}

	# Uploaded files (goods images).
	handle_path /media/* {
		root * "__MEDIA_ROOT__"
		file_server
	}

	# The backend's own paths always go to the backend.
	@backend path_regexp backend ^/(api/v1|api/schema|api/docs|api-auth|admin|health|test-console|static)(/|$)
	handle @backend {
		reverse_proxy 127.0.0.1:__WEB_PORT__
	}

	# Everything else: the frontend.
	handle {
		reverse_proxy 127.0.0.1:__FRONTEND_PORT__
	}
}

# Local only: the frontend server calls the backend here (API_URL), without TLS. It passes
# on the browser's address, and says the original request was HTTPS.
http://127.0.0.1:__INTERNAL_PORT__ {
	bind 127.0.0.1
	reverse_proxy 127.0.0.1:__WEB_PORT__ {
		header_up X-Forwarded-Proto https
	}
}
